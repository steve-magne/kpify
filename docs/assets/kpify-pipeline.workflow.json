  "cards": [
    {
      "dot": "cyan",
      "title": "Gate between stages",
      "items": [
        "check_artifacts.py --stage N: headings, KPI fields, results rows",
        "A stage starts only when the previous artifact is complete"
      ]
    },
    {
      "dot": "rose",
      "title": "No silent shortcuts",
      "items": [
        "Missing targets stay missing or are labeled hypothesis",
        "KPIs are UNVALIDATED until checked, BLOCKED without data"
      ]
    },
    {
      "dot": "amber",
      "title": "Iterative, not waterfall",
      "items": [
        "A later stage can send you back",
        "The reason goes in ## Revisions, never a silent rewrite"
      ]
    }
